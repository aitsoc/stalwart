# syntax=docker/dockerfile:1
# check=skip=FromPlatformFlagConstDisallowed,RedundantTargetPlatform

# Builds a single all-features stalwart binary + libfdb_c.so

# *****************
# Base image
# *****************
FROM --platform=$BUILDPLATFORM rust:slim-trixie AS base

ENV DEBIAN_FRONTEND="noninteractive" \
    BINSTALL_DISABLE_TELEMETRY=true \
    CARGO_TERM_COLOR=always \
    LANG=C.UTF-8 \
    TZ=UTC \
    TERM=xterm-256color \
    AWS_LC_SYS_PREBUILT_NASM=1

RUN \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    dpkg --add-architecture arm64 && \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache && \
    apt-get update && \
    apt-get install -yq --no-install-recommends ca-certificates curl jq xz-utils make cmake pkg-config libssl-dev libssl-dev:arm64 libcurl4-openssl-dev libclang-19-dev

RUN \
    ZIG_VERSION=0.13.0 && \
    curl --retry 5 -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-$(uname -m)-${ZIG_VERSION}.tar.xz" | tar -J -x -C /usr/local && \
    ln -s "/usr/local/zig-linux-$(uname -m)-${ZIG_VERSION}/zig" /usr/local/bin/zig && \
    zig version

RUN curl --retry 5 -fL --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash
RUN cargo binstall --no-confirm cargo-chef cargo-zigbuild sccache

# zig cc for cross-compilation does not search /usr/include by default,
# so copy curl headers into zig's own lib/include/ for all-target discovery.
RUN \
    curl_hdr_dir="$(dpkg -L libcurl4-openssl-dev | grep -m1 '/curl/curl\.h$' | xargs dirname)" && \
    [ -n "$curl_hdr_dir" ] && [ -d "$curl_hdr_dir" ] && \
    cp -r "$curl_hdr_dir" /usr/local/zig-linux-$(uname -m)-0.13.0/lib/include/curl

# *****************
# Planner
# *****************
FROM base AS planner
WORKDIR /app
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# *****************
# Builder — all features
# *****************
FROM base AS builder
WORKDIR /app
COPY --from=planner /app/recipe.json recipe.json
ARG TARGET
ARG BUILD_ENV

# Debian ships generated OpenSSL headers (opensslconf.h, configuration.h, ...)
# in the multiarch include dir, which zig cc does not search. Copy the target's
# generated headers into zig's own include dir so openssl-sys can find them —
# same problem/fix as the curl headers above. Must be target-aware: the amd64
# and arm64 packages install different generated headers.
RUN \
    multiarch="$(case "${TARGET%%-*}" in aarch64) echo aarch64-linux-gnu ;; *) echo x86_64-linux-gnu ;; esac)" && \
    openssl_inc="/usr/include/${multiarch}/openssl" && \
    [ -d "$openssl_inc" ] && \
    mkdir -p /usr/local/zig-linux-$(uname -m)-0.13.0/lib/include/openssl && \
    cp -r "$openssl_inc/." /usr/local/zig-linux-$(uname -m)-0.13.0/lib/include/openssl/

# Complete production feature set (matches crates/main/Cargo.toml default;
# dev_mode is intentionally excluded). foundationdb-c is not included:
# it would replace the native backend and is not part of the default build.
ARG FEATURES="sqlite,foundationdb,postgres,mysql,rocks,s3,redis,keep,azure,nats,exchange,enterprise,zenoh,kafka"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN \
    rustup set profile minimal && \
    rustup target add ${TARGET} && \
    mkdir -p artifact && \
    touch /env-cargo && \
    if [ ! -z "${BUILD_ENV}" ]; then \
        echo "export ${BUILD_ENV}" >> /env-cargo; \
        echo "Setting up ${BUILD_ENV}"; \
    fi && \
    base_arch="${TARGET%%-*}"; \
    case "$base_arch" in \
        x86_64) \
            echo "export FDB_ARCH=amd64" >> /env-cargo; \
            echo "export OPENSSL_LIB_DIR=/usr/lib/x86_64-linux-gnu" >> /env-cargo; \
            echo "export OPENSSL_INCLUDE_DIR=/usr/include" >> /env-cargo ;; \
        aarch64) \
            echo "export FDB_ARCH=aarch64" >> /env-cargo; \
            echo "export OPENSSL_LIB_DIR=/usr/lib/aarch64-linux-gnu" >> /env-cargo; \
            echo "export OPENSSL_INCLUDE_DIR=/usr/include" >> /env-cargo ;; \
    esac

ARG FDB_VERSION_RANGE="7.4"
RUN \
    --mount=type=secret,id=GITHUB_TOKEN,env=GH_TOKEN \
    source /env-cargo && \
    fdb_url="$(curl --retry 5 -fsSL -H "Authorization: token ${GH_TOKEN}" -H "Accept: application/vnd.github.v3+json" 'https://api.github.com/repos/apple/foundationdb/releases?per_page=100' | jq --arg FDB_ARCH "$FDB_ARCH" --arg RANGE "${FDB_VERSION_RANGE}" -r '[.[] | select(.tag_name | startswith($RANGE + ".")) | select(.prerelease == false) | select(.draft == false)] | sort_by(.tag_name | split(".") | map(tonumber)) | reverse | .[0].assets[] | select(.name | test("foundationdb-clients.*" + $FDB_ARCH + ".deb$")) | .browser_download_url')" && \
    if [ -z "$fdb_url" ]; then echo "ERROR: could not resolve FoundationDB client download URL for ${FDB_ARCH} / ${FDB_VERSION_RANGE}" >&2; exit 1; fi && \
    curl --retry 5 -fLso fdb-client.deb "$fdb_url" && \
    mkdir -p /fdb && \
    dpkg -x fdb-client.deb /fdb && \
    mv /fdb/usr/include/foundationdb /usr/include && \
    mv /fdb/usr/lib/libfdb_c.so /usr/lib && \
    rm -rf fdb-client.deb /fdb

RUN \
    --mount=type=secret,id=ACTIONS_RESULTS_URL,env=ACTIONS_RESULTS_URL \
    --mount=type=secret,id=ACTIONS_RUNTIME_TOKEN,env=ACTIONS_RUNTIME_TOKEN \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    source /env-cargo && \
    RUSTFLAGS="-L /usr/lib" cargo chef cook --recipe-path recipe.json --zigbuild --release --target ${TARGET} -p stalwart --no-default-features --features "${FEATURES}"

COPY . .

ENV RUSTC_WRAPPER="sccache"

RUN \
    --mount=type=secret,id=ACTIONS_RESULTS_URL,env=ACTIONS_RESULTS_URL \
    --mount=type=secret,id=ACTIONS_RUNTIME_TOKEN,env=ACTIONS_RUNTIME_TOKEN \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    source /env-cargo && \
    RUSTFLAGS="-L /usr/lib" cargo-zigbuild build --release --target ${TARGET} -p stalwart --no-default-features --features "${FEATURES}" && \
    mv /app/target/${TARGET}/release/stalwart /app/artifact/stalwart

# *****************
# Binary-only stage
# *****************
FROM scratch AS binaries
COPY --from=builder /app/artifact/stalwart /stalwart
COPY --from=builder /usr/lib/libfdb_c.so /libfdb_c.so
