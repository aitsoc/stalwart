# syntax=docker/dockerfile:1
# check=skip=FromPlatformFlagConstDisallowed,RedundantTargetPlatform

# Builds a single all-features stalwart binary + libfdb_c.so

# *****************
# Base image (RHEL 10 / UBI 10)
# *****************
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi10/ubi:10.2 AS base

ENV BINSTALL_DISABLE_TELEMETRY=true \
    CARGO_TERM_COLOR=always \
    LANG=C.UTF-8 \
    TZ=UTC \
    TERM=xterm-256color \
    AWS_LC_SYS_PREBUILT_NASM=1 \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"

RUN \
    --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    dnf install -y --setopt=install_weak_deps=0 \
        --enablerepo=codeready-builder-for-ubi-10-x86_64-rpms \
        gcc gcc-c++ make cmake perl pkg-config xz cpio ca-certificates curl libcurl-devel clang-devel && \
    dnf clean all && \
    curl --retry 5 -fLso /usr/local/bin/jq https://github.com/jqlang/jq/releases/download/jq-1.8.1/jq-linux-amd64 && \
    chmod 755 /usr/local/bin/jq && \
    curl --retry 5 -fL --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path --default-toolchain stable && \
    rustc --version && cargo --version

RUN \
    ZIG_VERSION=0.13.0 && \
    curl --retry 5 -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-$(uname -m)-${ZIG_VERSION}.tar.xz" | tar -J -x -C /usr/local && \
    ln -s "/usr/local/zig-linux-$(uname -m)-${ZIG_VERSION}/zig" /usr/local/bin/zig && \
    zig version

RUN curl --retry 5 -fL --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash
RUN cargo binstall --no-confirm cargo-chef cargo-zigbuild sccache

# zig cc for cross-compilation does not search the system include dir by
# default, so copy curl headers into zig's own lib/include/ for all-target
# discovery.
RUN \
    curl_hdr_dir="$(rpm -ql libcurl-devel | grep -m1 '/curl/curl\.h$' | xargs dirname)" && \
    [ -n "$curl_hdr_dir" ] && [ -d "$curl_hdr_dir" ] && \
    cp -r "$curl_hdr_dir" /usr/local/zig-linux-$(uname -m)-0.13.0/lib/include/curl

# *****************
# Planner
# *****************
FROM base AS planner
WORKDIR /app
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# *****************
# Builder — all features
# *****************
FROM base AS builder
WORKDIR /app
COPY --from=planner /app/recipe.json recipe.json
ARG TARGET
ARG BUILD_ENV

# Complete production feature set (matches crates/main/Cargo.toml default;
# dev_mode is intentionally excluded). foundationdb-c is not included:
# it would replace the native backend and is not part of the default build.
ARG FEATURES="sqlite,foundationdb,postgres,mysql,rocks,s3,redis,keep,azure,nats,exchange,enterprise,zenoh,kafka"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN \
    rustup set profile minimal && \
    rustup target add ${TARGET} && \
    mkdir -p artifact && \
    touch /env-cargo && \
    if [ ! -z "${BUILD_ENV}" ]; then \
        echo "export ${BUILD_ENV}" >> /env-cargo; \
        echo "Setting up ${BUILD_ENV}"; \
    fi && \
    base_arch="${TARGET%%-*}"; \
    case "$base_arch" in \
        x86_64) echo "export FDB_ARCH=amd64" >> /env-cargo ;; \
        aarch64) echo "export FDB_ARCH=aarch64" >> /env-cargo ;; \
    esac

ARG FDB_VERSION_RANGE="7.4"
RUN \
    --mount=type=secret,id=GITHUB_TOKEN,env=GH_TOKEN \
    source /env-cargo && \
    fdb_arch="$(case "$FDB_ARCH" in amd64) echo x86_64 ;; aarch64) echo aarch64 ;; esac)" && \
    fdb_url="$(curl --retry 5 -fsSL -H "Authorization: token ${GH_TOKEN}" -H "Accept: application/vnd.github.v3+json" 'https://api.github.com/repos/apple/foundationdb/releases?per_page=100' | jq --arg FDB_ARCH "$fdb_arch" --arg RANGE "${FDB_VERSION_RANGE}" -r '[.[] | select(.tag_name | startswith($RANGE + ".")) | select(.prerelease == false) | select(.draft == false)] | sort_by(.tag_name | split(".") | map(tonumber)) | reverse | .[0].assets[] | select(.name | test("foundationdb-clients.*" + $FDB_ARCH + "\\.rpm$")) | select(.name | contains("debuginfo") | not) | .browser_download_url')" && \
    if [ -z "$fdb_url" ]; then echo "ERROR: could not resolve FoundationDB client RPM URL for ${fdb_arch} / ${FDB_VERSION_RANGE}" >&2; exit 1; fi && \
    curl --retry 5 -fLso /fdb-client.rpm "$fdb_url" && \
    mkdir -p /fdb && rpm2cpio /fdb-client.rpm | (cd /fdb && cpio -idmv) && \
    fdb_lib="$(find /fdb -name libfdb_c.so -print -quit)" && \
    if [ -z "$fdb_lib" ]; then echo "ERROR: libfdb_c.so not found in FoundationDB client RPM" >&2; exit 1; fi && \
    cp "$fdb_lib" /usr/lib64/libfdb_c.so && \
    if [ -d /fdb/usr/include/foundationdb ]; then cp -r /fdb/usr/include/foundationdb /usr/include/; fi && \
    rm -rf /fdb /fdb-client.rpm

RUN \
    --mount=type=secret,id=ACTIONS_RESULTS_URL,env=ACTIONS_RESULTS_URL \
    --mount=type=secret,id=ACTIONS_RUNTIME_TOKEN,env=ACTIONS_RUNTIME_TOKEN \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    source /env-cargo && \
    RUSTFLAGS="-L /usr/lib64" cargo chef cook --recipe-path recipe.json --zigbuild --release --target ${TARGET} -p stalwart --no-default-features --features "${FEATURES}"

COPY . .

ENV RUSTC_WRAPPER="sccache"

RUN \
    --mount=type=secret,id=ACTIONS_RESULTS_URL,env=ACTIONS_RESULTS_URL \
    --mount=type=secret,id=ACTIONS_RUNTIME_TOKEN,env=ACTIONS_RUNTIME_TOKEN \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    source /env-cargo && \
    RUSTFLAGS="-L /usr/lib64" cargo-zigbuild build --release --target ${TARGET} -p stalwart --no-default-features --features "${FEATURES}" && \
    mv /app/target/${TARGET}/release/stalwart /app/artifact/stalwart

# *****************
# Binary-only stage
# *****************
FROM scratch AS binaries
COPY --from=builder /app/artifact/stalwart /stalwart
COPY --from=builder /usr/lib64/libfdb_c.so /libfdb_c.so
